{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screencap",
  "version": "0.1.0",
  "identifier": "com.example.screencap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Screencap",
        "width": 960,
        "height": 640,
        "visible": false,
        "resizable": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Screencap Overlay",
        "url": "overlay.html",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "fullscreen": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "globalShortcut": {
      "all": true
    }
  }
}